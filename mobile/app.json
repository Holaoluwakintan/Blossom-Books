{
  "expo": {
    "name": "Blossom Stories",
    "slug": "blossom-stories",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "blossomstories",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blossomstories.app"
    },
    "android": {
      "package": "com.blossomstories.app",
      "adaptiveIcon": {
        "backgroundColor": "#d87558"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
